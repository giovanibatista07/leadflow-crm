# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma, via Supabase Postgres connection pooling)
DATABASE_URL=
DIRECT_URL=

# Base URL this app is served at, used to build invite links
# (e.g. http://localhost:3000 in dev, your real domain in production)
NEXT_PUBLIC_APP_URL=

# Google (Sheets import + Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Encryption key for storing Google tokens at rest
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Error tracking (PII-scrubbed before sending)
SENTRY_DSN=

# Cron job auth (checked by /api/cron/* routes). Generate with:
# openssl rand -hex 32
# Set this in both:
#  - Vercel project settings (env var), for completeness / vercel.json's
#    own cron entry if you upgrade off the free Hobby plan
#  - This repo's GitHub Actions secrets (Settings -> Secrets and
#    variables -> Actions), since .github/workflows/cron-sweep.yml is
#    what actually triggers the 15-minute sweep on the free plan
CRON_SECRET=

# GitHub Actions secret only (not a local/Vercel env var): the deployed
# site's URL, e.g. https://your-app.vercel.app -- set in the same place
# as CRON_SECRET above, read by .github/workflows/cron-sweep.yml
# APP_URL=
