# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Prisma, via Supabase Postgres connection pooling)
DATABASE_URL=
DIRECT_URL=

# Base URL this app is served at, used to build invite links
# (e.g. http://localhost:3000 in dev, your real domain in production)
NEXT_PUBLIC_APP_URL=

# Google (Sheets import + Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Encryption key for storing Google tokens at rest
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Error tracking (PII-scrubbed before sending)
SENTRY_DSN=

# Cron job auth (Vercel Cron, or netlify/functions/cron-sweep.ts on
# Netlify -> /api/cron/*). Generate with: openssl rand -hex 32
CRON_SECRET=

# Not set by hand on Netlify: it auto-injects URL (the site's production
# URL) and DEPLOY_PRIME_URL at build/runtime, which netlify/functions/
# cron-sweep.ts reads to call this site's own /api/cron/due-steps.
